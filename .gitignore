# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# OS
.DS_Store

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env / secrets — never commit real credentials
.env
.env.*
!.env.example

# Personal data that must never be committed: exported backups, PDFs of
# patterns, photos, or anything pulled out of the app for local use.
/backups/
/exports/
*.pdf
!docs/**/*.pdf
